# ============================================================
# AI DIGITAL TWIN BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ============================================================
# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (e.g., mongodb://localhost:27017/student_placement_twin)
MONGODB_URI=mongodb://localhost:27017/student_placement_twin

# Client Origin for CORS Configuration
FRONTEND_URL=http://localhost:5173

# Authentication & JWT Configuration (Phase 4)
JWT_SECRET=replace_with_your_own_random_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Phase 7 — AI Resume Analyzer & Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_RESUME_SIZE_MB=10
RESUME_UPLOAD_DIR=uploads/resumes

